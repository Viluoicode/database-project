@model IEnumerable<WatchEcommerce.Models.Product>

@{
    ViewData["Title"] = "Danh sách đồng hồ";
}

<h1>Danh sách đồng hồ</h1>

<div class="row mb-3">
    <div class="col-md-8">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm kiếm theo tên hoặc thương hiệu..." />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Tìm kiếm
                </button>
            </div>
        </form>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm sản phẩm mới
        </a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-12">
        <div class="btn-group" role="group">
            <a asp-action="Index" class="btn btn-outline-primary @(ViewData["CategoryId"] == null ? "active" : "")">
                Tất cả
            </a>
            @if (ViewBag.Categories != null)
            {
                foreach (var category in ViewBag.Categories)
                {
                    var isActive = ViewData["CategoryId"]?.ToString() == category.CategoryID.ToString() ? "active" : "";
                    <a asp-action="Index" asp-route-categoryId="@category.CategoryID" class="btn btn-outline-primary @isActive">
                        @category.CategoryName
                    </a>
                }
            }
        </div>
    </div>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@Html.DisplayFor(modelItem => item.ProductName)</h5>
                        <p class="card-text">
                            <strong>Thương hiệu:</strong> @Html.DisplayFor(modelItem => item.Brand)<br />
                            <strong>Danh mục:</strong> @Html.DisplayFor(modelItem => item.Category.CategoryName)<br />
                            <strong>Giá:</strong> <span class="text-danger">@item.Price.ToString("N0") VNĐ</span><br />
                            <strong>Tồn kho:</strong> @Html.DisplayFor(modelItem => item.StockQuantity)
                        </p>
                        <div class="btn-group" role="group">
                            <a asp-action="Details" asp-route-id="@item.ProductID" class="btn btn-sm btn-info">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.ProductID" class="btn btn-sm btn-warning">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.ProductID" class="btn btn-sm btn-danger">Xóa</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">
                Không tìm thấy sản phẩm nào.
            </div>
        </div>
    }
</div>
